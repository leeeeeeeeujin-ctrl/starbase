# Local development environment variables (do not commit real secrets)
# Copy this file to .env.local and fill in values, or run:
#   npx vercel env pull .env.local
# to pull them from your linked Vercel project.

# Public (embedded into client at build time)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only (optional for local dev; used by server-side API routes if present)
# SUPABASE_SERVICE_ROLE=

# Cloudflare R2 (server-only)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=
# R2_S3_ENDPOINT= # optional, e.g. https://<account>.r2.cloudflarestorage.com

# Client-visible R2 public base (optional; if set, used by ChatOverlay to fetch attachments)
# NEXT_PUBLIC_R2_PUBLIC_BASE_URL=

# R2 Free-tier quota caps (optional; defaults below if unset)
# R2_MAX_STORAGE_BYTES=10737418240
# R2_MAX_CLASS_A_OPS=1000000
# R2_MAX_CLASS_B_OPS=10000000

# Optional debug toggles
# NEXT_PUBLIC_MATCH_DEBUG_HOLD=false
