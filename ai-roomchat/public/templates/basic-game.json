{
  "id": "basic-game",
  "name": "Basic Game Template",
  "version": "0.1.0",
  "variables": {
    "playerName": "Ranger",
    "difficulty": "normal"
  },
  "nodes": [
    {
      "id": "start",
      "type": "prompt",
      "name": "Intro",
      "prompt": "You are {{playerName}} entering the dungeon on {{difficulty}} difficulty.",
      "outputs": ["intro"]
    },
    {
      "id": "decision-1",
      "type": "decision",
      "name": "Choose Path",
      "params": { "paths": ["left", "right"] },
      "outputs": ["left", "right"]
    },
    {
      "id": "left-room",
      "type": "prompt",
      "name": "Left Room",
      "prompt": "You went left and found a puzzle box.",
      "outputs": ["leftOutcome"]
    },
    {
      "id": "right-room",
      "type": "prompt",
      "name": "Right Room",
      "prompt": "You went right and met a friendly slime.",
      "outputs": ["rightOutcome"]
    },
    {
      "id": "the-end",
      "type": "output",
      "name": "End",
      "outputs": []
    }
    
  ],
  "edges": [
    { "from": "start", "to": "decision-1" },
    { "from": "decision-1", "to": "left-room", "mapping": { "branch": "left" } },
    { "from": "decision-1", "to": "right-room", "mapping": { "branch": "right" } },
    { "from": "left-room", "to": "the-end" },
    { "from": "right-room", "to": "the-end" }
  ],
  "testCases": [
    { "name": "Left path", "variables": { "playerName": "Aria", "difficulty": "hard", "branch": "left" } },
    { "name": "Right path", "variables": { "playerName": "Bren", "difficulty": "easy", "branch": "right" } }
  ]
}

