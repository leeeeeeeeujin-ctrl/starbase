{
  "extends": ["next/core-web-vitals"],
  "rules": {
    "no-restricted-syntax": [
      "error,",
      {
        "selector": "CallExpression[callee.name='URL']",
        "message": "Use 'new URL(...)' instead of calling URL as a function"
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.json"],
      "plugins": ["jsonc"],
      "parser": "jsonc-eslint-parser",
      "rules": {
        "jsonc/valid-json-number": "error",
        "jsonc/no-dupe-keys": "error"
      }
    }
  ]
}
