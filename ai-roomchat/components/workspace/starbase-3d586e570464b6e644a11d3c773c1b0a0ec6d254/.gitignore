# Ignore archived snapshot directories (local archives, large files, etc.)
archived/

# Ignore local environment files which may contain secrets
# Developers should keep a local `.env.local` (not committed). Use `.env.local.example` as a template.
.env.local
**/.env.local
*.Local

# Ignore runtime and log directories created by local runs
ai-roomchat/logs/

# Ignore migration diagnostic artifacts and local backups
ai-roomchat/*.json
!ai-roomchat/.eslintrc.json
!ai-roomchat/tsconfig.checkjs.json
ai-roomchat/*_raw.txt
ai-roomchat/list*.txt
ai-roomchat/*.gz
ai-roomchat/*.sha256
ai-roomchat/downloaded-backup.*
ai-roomchat/migration-backup-*.sql
ai-roomchat/upload_response_body.txt

# ignore local data backups created by dev tools
ai-roomchat/data/*.json

# Sensitive keys and SPPP files (do NOT commit)
ci_deploy_key
ci_deploy_key.pub
ai-roomchat/SPPP*
ai-roomchat/SPPP_key*
SPPP_www
SPPP_www.*
SPPP_url
SPPP_url.*
ai-roomchat/SPPP_url*

# Common large/runtime dirs we don't want in the repo
artifacts/
reports/
tmp/
assistant-sql/
.tmp.driveupload/

# Ignore large reference data checked into docs (keep locally, don't commit)
ai-roomchat/docs/reference_data/
ai-roomchat/docs/reference_data/**
