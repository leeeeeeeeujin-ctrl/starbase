{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Node",
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "types": []
  },
  "include": [
    "components/**/*.jsx",
    "lib/**/*.js",
    "pages/**/*.js",
    "proxy/**/*.js",
    "mobile/**/*.js",
    "tools/**/*.js"
  ],
  "exclude": ["node_modules", ".next"]
}

