{
  "name": "ai-roomchat-pages",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/prepare-pokerogue-upstream.mjs",
    "dev": "next dev",
    "dev:runner-test": "node scripts/run-runner-and-test.js",
    "build": "next build",
    "export": "next build && next export",
    "build:compatibility": "npm run build && npm run test:compatibility",
    "start": "next start",
    "env:pull": "vercel env pull .env.local --environment=development",
    "env:pull:preview": "vercel env pull .env.local --environment=preview",
    "env:pull:prod": "vercel env pull .env.local --environment=production",
    "vercel:env": "node scripts/syncVercelEnv.js",
    "refresh:blueprint-progress": "node scripts/refresh-rank-blueprint-progress.js",
    "check:blueprint-progress-freshness": "node scripts/check-rank-blueprint-progress-freshness.js",
    "check:blueprint-next-actions": "node scripts/check-rank-blueprint-next-actions.js",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:compatibility": "jest --config jest.compatibility.config.js",
    "test:fuzz": "jest --config jest.fuzz.config.js",
    "test:samples": "node scripts/run-matching-samples.js",
    "test:matching:anomalies": "node scripts/run-matching-anomaly-scan.js",
    "test:matching:pools": "node scripts/run-matching-pool-scenarios.js",
    "migrate:db": "node scripts/apply-migrations.js",
    "seed:schema-migrations": "node scripts/seed-schema-migrations.js",
    "migrate:apply-sppp": "node scripts/apply-migrations-with-sppp.js",
    "migrate:ipv4": "node scripts/run-migrations-ipv4.js",
    "device-runner": "node lib/clientRunner/shim.js",
    "lint": "eslint . --ext .js,.jsx --max-warnings=0",
    "notify:audio-events": "node scripts/notify-audio-event-trends.js",
    "deploy:edge-functions": "node scripts/deploy-edge-functions.js",
    "check:edge-deploy-config": "node scripts/verify-edge-deploy-config.js",
    "simulate:start-engine": "node scripts/start-engine-simulator.js",
    "status": "node scripts/status-check.js",
    "commit": "node scripts/quick-commit.js",
    "workflow": "node scripts/dev-workflow.js",
    "ai-workers": "node scripts/ai-worker-pool-openai.js",
    "test:ai-workers": "node scripts/test-ai-workers.js",
    "experiment:main": "node scripts/experiment-main-flow.js",
    "experiment:matrix": "node scripts/experiment-matrix.js",
    "chatgpt:web": "node scripts/run-chatgpt-web-prompt.js",
    "chatgpt:web:bridge": "node tools/chatgpt-web-helper-server.js",
    "simulate:text-battle": "node scripts/simulate-text-battle-runtime.mjs",
    "simulate:battle-selection": "npx jest __tests__/lib/battle/matchReadiness.simulation.test.js --runInBand --silent=false",
    "wasm:build": "node scripts/wasm_build.js",
    "blockly:convert": "node scripts/blockly_poc.js workflows/blockly-sample.json workflows/blockly-sample.out.js",
    "test:blockly": "node scripts/test_blockly.js",
    "blockly:run-local": "node scripts/run_blockly_local_runner.js",
    "typecheck": "tsc -p tsconfig.checkjs.json --noEmit",
    "lint:json": "eslint public/templates/*.json --ext .json",
    "studio:bridge": "node mobile/cli-bridge.js",
    "studio:test:mock": "node tools/test_mock_runner.js",
    "studio:test:cli": "node tools/test_cli_bridge.js",
    "r2:cors:set": "node scripts/set-r2-cors.js",
    "r2:cors:get": "node scripts/get-r2-cors.js",
    "mobile:build": "node scripts/gen-mobile-endpoints.js && next build && npx cap copy",
    "mobile:sync": "npx cap sync",
    "mobile:android": "npx cap open android",
    "mobile:ios": "npx cap open ios",
    "rank:cleanup:sessions": "node scripts/cleanupExpiredRankSessions.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1031.0",
    "@aws-sdk/s3-request-presigner": "^3.1031.0",
    "@capacitor/core": "^6.2.0",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "@imgly/background-removal-node": "^1.4.5",
    "@monaco-editor/loader": "^1.4.1",
    "@sentry/nextjs": "^7.50.0",
    "@supabase/auth-helpers-nextjs": "^0.10.0",
    "@supabase/ssr": "^0.6.0",
    "@supabase/supabase-js": "^2.76.1",
    "body-parser": "^2.2.0",
    "core-js": "^3.37.1",
    "cors": "^2.8.5",
    "cross-fetch": "^3.1.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "googleapis": "^161.0.0",
    "intersection-observer": "^0.12.2",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.0",
    "minimist": "^1.2.8",
    "monaco-editor": "^0.52.2",
    "next": "^16.2.4",
    "node-fetch": "^3.3.2",
    "openai": "^4.67.1",
    "pino": "^8.14.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "reactflow": "^11.11.4",
    "regenerator-runtime": "^0.14.1",
    "resize-observer-polyfill": "^1.5.1",
    "sharp": "^0.32.6",
    "whatwg-fetch": "^3.6.20",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-nullish-coalescing-operator": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "@babel/plugin-transform-runtime": "^7.24.5",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.24.5",
    "@babel/runtime": "^7.24.5",
    "@capacitor/android": "^6.2.0",
    "@capacitor/cli": "^6.2.0",
    "@capacitor/ios": "^6.2.0",
    "@next/eslint-plugin-next": "^16.0.1",
    "@playwright/test": "^1.55.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "ajv": "^8.17.1",
    "autoprefixer": "^10.4.19",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "babel-plugin-transform-define": "^2.1.4",
    "babel-plugin-transform-imports": "^2.0.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.33",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-jsonc": "^2.15.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "jsonc-eslint-parser": "^2.4.0",
    "lint-staged": "^16.2.6",
    "pg": "^8.10.0",
    "postcss": "^8.4.38",
    "postcss-preset-env": "^9.5.14",
    "react-refresh": "^0.18.0",
    "react-test-renderer": "18.2.0",
    "typescript": "^5.6.3",
    "wabt": "^1.0.33"
  },
  "lint-staged": {
    "*.{js,jsx}": [
      "eslint --fix",
      "git add"
    ]
  },
  "r2": {
    "note": "Run these with CF_API_TOKEN, R2_ACCOUNT_ID, R2_BUCKET set"
  }
}
