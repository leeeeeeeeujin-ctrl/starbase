{
  "name": "0614",
  "short_name": "0614",
  "description": "AI-powered game development platform with offline support",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#1a1a2e",
  "theme_color": "#4fc3f7",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "ko-KR",
  "dir": "ltr",

  "icons": [
    {
      "src": "/icon.png",
      "sizes": "512x512 192x192",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],

  "screenshots": [],

  "categories": ["games", "developer", "productivity", "education"],
  "iarc_rating_id": "",

  "prefer_related_applications": false,
  "related_applications": [],

  "shortcuts": [
    {
      "name": "New Game Project",
      "short_name": "New Project",
      "description": "Create a new AI game project",
      "url": "/projects/new",
      "icons": [{ "src": "/icon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "AI Code Assistant",
      "short_name": "AI Assistant",
      "description": "Open AI coding assistant",
      "url": "/ai-assistant",
      "icons": [{ "src": "/icon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Projects",
      "short_name": "Projects",
      "description": "View all my game projects",
      "url": "/projects",
      "icons": [{ "src": "/icon.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Game Demo",
      "short_name": "Demo",
      "description": "Test game engine features",
      "url": "/demo",
      "icons": [{ "src": "/icon.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],

  "file_handlers": [
    {
      "action": "/editor",
      "accept": {
        "application/javascript": [".js"],
        "application/json": [".json"],
        "text/python": [".py"],
        "text/sql": [".sql"],
        "text/markdown": [".md"]
      }
    }
  ],

  "protocol_handlers": [
    {
      "protocol": "web+starbase",
      "url": "/open?url=%s"
    }
  ],

  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": ["text/*", "application/javascript", "application/json"]
        }
      ]
    }
  },

  "display_override": ["window-controls-overlay", "minimal-ui"],
  "edge_side_panel": {
    "preferred_width": 400
  }
}
